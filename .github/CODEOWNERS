src/components/finance/                 @tylercreatorscorner  # owner: agent/finance
src/components/invoicing/               @tylercreatorscorner  # owner: agent/finance

# ─── Shared / cross-cutting (any agent may touch with care) ─────────────
# These paths intentionally have no agent label. The scope-check workflow
# treats anything not listed above as "shared" — any agent can edit, but
# changes here ripple across sections, so they should be small and obvious.
#   src/lib/                  Shared utilities, data layer, RPCs
#   src/components/ui/        Design-system primitives
#   src/components/layout/    Sidebar, shell, navigation
#   src/components/charts/    Shared chart components
#   src/types/                TypeScript types
#   src/app/api/              Backend API routes
#   src/app/actions/          Server actions
#
# ─── Out of bounds for agents (humans only) ──────────────────────────────
# Schema migrations, dependency changes, and platform admin pages should
# come from non-agent branches (e.g. `chore/...`, `infra/...`):
#   supabase/migrations/      DB schema changes
#   package.json              Dependency changes
#   tsconfig.json, next.config, etc.
#   src/app/(admin)/settings/, /upload/, /system/, /brands/
#   .github/                  CI/CD config (this file lives here)
