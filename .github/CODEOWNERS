# CODEOWNERS — section ownership for tempo-app
# https://docs.github.com/en/repositories/managing-your-repositories-settings-and-security/customizing-your-repository/about-code-owners
#
# Each app section is owned by a specific agent (one Claude Code session,
# working in its own git worktree on the matching `agent/<section>` branch).
# Because Tyler is the only human user, the GitHub-side "owner" for every
# path resolves to @tylercreatorscorner — the labels in comments tell you
# (and any future maintainer) which agent's branch should be touching what.
#
# Hard enforcement (i.e. blocking a dashboard agent's PR from merging if it
# touches /finance/ files) lives in .github/workflows/agent-scope-check.yml.
# This file is for documentation, auto-assignment, and future team-based
# ownership if you add collaborators.

# ─── Default ─────────────────────────────────────────────────────────────
*                                       @tylercreatorscorner

# ─── Dashboard agent ─────────────────────────────────────────────────────
src/app/(admin)/dashboard/              @tylercreatorscorner  # owner: agent/dashboard
src/components/dashboard/               @tylercreatorscorner  # owner: agent/dashboard

# ─── Creators agent ──────────────────────────────────────────────────────
src/app/(admin)/roster/                 @tylercreatorscorner  # owner: agent/creators
src/app/(admin)/creators/               @tylercreatorscorner  # owner: agent/creators
src/app/(admin)/messages/               @tylercreatorscorner  # owner: agent/creators
src/app/(admin)/discover/               @tylercreatorscorner  # owner: agent/creators
src/app/(admin)/invites/                @tylercreatorscorner  # owner: agent/creators
src/components/creators/                @tylercreatorscorner  # owner: agent/creators
src/components/messages/                @tylercreatorscorner  # owner: agent/creators

# ─── Content agent ───────────────────────────────────────────────────────
src/app/(admin)/posts/                  @tylercreatorscorner  # owner: agent/content
src/app/(admin)/reporting/              @tylercreatorscorner  # owner: agent/content
src/app/(admin)/discord-posts/          @tylercreatorscorner  # owner: agent/content
src/app/(admin)/discord-scan/           @tylercreatorscorner  # owner: agent/content
src/app/(admin)/discord-links/          @tylercreatorscorner  # owner: agent/content
src/components/posts/                   @tylercreatorscorner  # owner: agent/content
src/components/reporting/               @tylercreatorscorner  # owner: agent/content

# ─── Insights agent ──────────────────────────────────────────────────────
src/app/(admin)/analytics/              @tylercreatorscorner  # owner: agent/insights
src/components/analytics/               @tylercreatorscorner  # owner: agent/insights

# ─── Finance agent ───────────────────────────────────────────────────────
src/app/(admin)/earnings/               @tylercreatorscorner  # owner: agent/finance
